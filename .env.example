# 로컬 개발용: 이 파일을 .env.local로 복사해서 값을 채우세요.
# (App Hosting 배포 환경에서는 apphosting.yaml과 자동 주입 값이 쓰이므로 필요 없음)

# --- Firebase 웹 앱 공개 설정 (콘솔 > 프로젝트 설정 > 내 앱) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- 서버 전용 ---
# Gemini API 키 (https://aistudio.google.com/apikey). 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Admin SDK 인증: 서비스 계정 키 JSON 파일 경로 (또는 `gcloud auth application-default login`)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 허용할 교사 이메일(쉼표 구분). 비우면 로그인한 누구나 사용 가능.
ALLOWED_TEACHER_EMAILS=boongssam@gmail.com
